<Window x:Class="Dot9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dot9"
        xmlns:controls="clr-namespace:Dot9.Controls"
        Title="Dot[9]"
        Width="1180" Height="820"
        MinWidth="980" MinHeight="720"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="220" />
            <!-- Content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════
             SIDEBAR
        ══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">

                <!-- Wordmark at top -->
                <controls:WordmarkControl DockPanel.Dock="Top" Margin="0,0,0,28" />

                <!-- "Watch intro" at bottom -->
                <Button DockPanel.Dock="Bottom"
                        x:Name="ReplayWelcomeBtn"
                        Style="{StaticResource NavButton}"
                        HorizontalAlignment="Stretch"
                        Click="ReplayWelcome"
                        Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource NavIcon}" />
                        <TextBlock Text="Watch intro" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Nav items (icons: Segoe Fluent / MDL2 assets, ship with Windows 10/11) -->
                <StackPanel>
                    <Button x:Name="NavPresets"
                            Style="{StaticResource NavButtonActive}"
                            HorizontalAlignment="Stretch"
                            Click="ShowPresets"
                            Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Presets" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTune"
                            Style="{StaticResource NavButton}"
                            HorizontalAlignment="Stretch"
                            Click="ShowTune"
                            Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9E9;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Tune" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHotkeys"
                            Style="{StaticResource NavButton}"
                            HorizontalAlignment="Stretch"
                            Click="ShowHotkeys"
                            Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Hotkeys" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSafety"
                            Style="{StaticResource NavButton}"
                            HorizontalAlignment="Stretch"
                            Click="ShowSafety"
                            Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB51;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Safety" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAbout"
                            Style="{StaticResource NavButton}"
                            HorizontalAlignment="Stretch"
                            Click="ShowAbout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             CONTENT COLUMN (TopBar + Views + Footer)
        ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- TopBar -->
                <RowDefinition Height="Auto" />
                <!-- Active view -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── TopBar ── -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <DockPanel>
                    <!-- Right side: action buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ToggleOverlayBtn"
                                Content="{Binding ToggleButtonText}"
                                Click="ToggleOverlay"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- Highlight the call-to-action while the overlay is off -->
                                        <DataTrigger Binding="{Binding OverlayEnabled}" Value="False">
                                            <Setter Property="Background"      Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground"      Value="{StaticResource AccentInkBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FontWeight"      Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="TrayPopoverBtn"
                                Content="▴"
                                Padding="10,9"
                                Click="OpenTrayPopover" />
                    </StackPanel>

                    <!-- Left side: status indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource InkDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="{Binding OverlayStatusLine}"
                                       FontSize="13"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding HotkeySummary}"
                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas, Courier New"
                                       FontSize="11"
                                       Foreground="{StaticResource InkDimBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Views ── -->
            <Grid Grid.Row="1" Margin="20">

                <!-- ─── TUNE VIEW ─── -->
                <!-- One ScrollViewer for both columns: two side-by-side scrollbars read as clutter. -->
                <ScrollViewer x:Name="TuneView" Visibility="Collapsed">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: preview + edge dots -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <StackPanel VerticalAlignment="Top">

                            <!-- Live preview card -->
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="340" />
                                    </Grid.RowDefinitions>

                                    <!-- Preview header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="LIVE PREVIEW"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas, Courier New"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource InkDimBrush}"
                                                   VerticalAlignment="Center" />
                                        <!-- Right side: reset -->
                                        <Button x:Name="ResetToDefaultsBtn"
                                                Content="Reset to defaults"
                                                Padding="10,6"
                                                FontSize="11"
                                                HorizontalAlignment="Right"
                                                Click="ResetToDefaults_Click" />
                                    </Grid>

                                    <local:PreviewSurface x:Name="HomePreview" Grid.Row="1" />
                                </Grid>
                            </Border>

                            <!-- Edge dots section -->
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <!-- Section header -->
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Edge dots"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <CheckBox HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Edge dots"
                                                  IsChecked="{Binding DotsEnabled}" />
                                    </Grid>

                                    <!-- Body (dims when disabled) -->
                                    <StackPanel IsEnabled="{Binding DotsEnabled}"
                                                Opacity="{Binding DotsEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <!-- Opacity -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Opacity" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding DotOpacity, Converter={StaticResource Percent}, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Margin="0,0,0,14"
                                                AutomationProperties.Name="Edge dot opacity"
                                                Value="{Binding DotOpacity, Converter={StaticResource Percent}, Mode=TwoWay}" />

                                        <!-- Size -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Size" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding DotSize, StringFormat={}{0:F0}px}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="4" Maximum="60" Margin="0,0,0,14"
                                                AutomationProperties.Name="Edge dot size"
                                                Value="{Binding DotSize, Mode=TwoWay}" />

                                        <!-- Edge distance -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Edge distance" FontSize="13" />
                                            <!-- px, not % — the renderer treats EdgeDistance as device-independent pixels -->
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding DotEdgeDistance, StringFormat={}{0:F0}px}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="8" Maximum="120" Margin="0,0,0,14"
                                                AutomationProperties.Name="Edge dot distance from edge"
                                                Value="{Binding DotEdgeDistance, Mode=TwoWay}" />

                                        <!-- Dots per edge -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Dots per edge" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding DotsPerEdge, StringFormat={}{0:F0}}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="3" Maximum="24" Margin="0,0,0,16"
                                                AutomationProperties.Name="Dots per edge"
                                                Value="{Binding DotsPerEdge, Mode=TwoWay}" />

                                        <!-- Edges + Shape row -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Edges" FontSize="12"
                                                           Foreground="{StaticResource InkMutedBrush}"
                                                           Margin="0,0,0,6" />
                                                <Border Style="{StaticResource SegmentedContainer}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton GroupName="EdgesGroup" Content="L+R"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotEdges, Converter={StaticResource EnumToBool}, ConverterParameter=LeftRight}" />
                                                        <RadioButton GroupName="EdgesGroup" Content="T+B"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotEdges, Converter={StaticResource EnumToBool}, ConverterParameter=TopBottom}" />
                                                        <RadioButton GroupName="EdgesGroup" Content="All"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotEdges, Converter={StaticResource EnumToBool}, ConverterParameter=AllEdges}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Shape" FontSize="12"
                                                           Foreground="{StaticResource InkMutedBrush}"
                                                           Margin="0,0,0,6" />
                                                <Border Style="{StaticResource SegmentedContainer}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton GroupName="ShapeGroup" Content="Dot"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotShape, Converter={StaticResource EnumToBool}, ConverterParameter=Circle}" />
                                                        <RadioButton GroupName="ShapeGroup" Content="Ring"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotShape, Converter={StaticResource EnumToBool}, ConverterParameter=Ring}" />
                                                        <RadioButton GroupName="ShapeGroup" Content="Soft"
                                                                     Style="{StaticResource SegmentedOption}"
                                                                     IsChecked="{Binding DotShape, Converter={StaticResource EnumToBool}, ConverterParameter=SoftGlow}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Colour swatches -->
                                        <TextBlock Text="Colour" FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Margin="0,0,0,8" />
                                        <controls:SwatchRow x:Name="DotSwatches"
                                                            SelectedColor="{Binding DotColor, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- Right column: Centre + Horizon + Vignette + Monitor -->
                    <Grid Grid.Column="1">
                        <StackPanel VerticalAlignment="Top">

                            <!-- Centre point -->
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Centre point"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Centre point"
                                                  IsChecked="{Binding CentreEnabled}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding CentreEnabled}"
                                                Opacity="{Binding CentreEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <!-- Opacity -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Opacity" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding CentreOpacity, Converter={StaticResource Percent}, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Margin="0,0,0,14"
                                                AutomationProperties.Name="Centre point opacity"
                                                Value="{Binding CentreOpacity, Converter={StaticResource Percent}, Mode=TwoWay}" />
                                        <!-- Size -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Size" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding CentreSize, StringFormat={}{0:F0}px}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="4" Maximum="32" Margin="0,0,0,14"
                                                AutomationProperties.Name="Centre point size"
                                                Value="{Binding CentreSize, Mode=TwoWay}" />
                                        <!-- Shape -->
                                        <TextBlock Text="Shape" FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SegmentedContainer}" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton GroupName="CentreShapeGroup" Content="Ring"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding CentreShape, Converter={StaticResource EnumToBool}, ConverterParameter=Ring}" />
                                                <RadioButton GroupName="CentreShapeGroup" Content="Dot"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding CentreShape, Converter={StaticResource EnumToBool}, ConverterParameter=Dot}" />
                                                <RadioButton GroupName="CentreShapeGroup" Content="Cross"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding CentreShape, Converter={StaticResource EnumToBool}, ConverterParameter=Cross}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Horizon line -->
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Horizon line"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Horizon line"
                                                  IsChecked="{Binding HorizonEnabled}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding HorizonEnabled}"
                                                Opacity="{Binding HorizonEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <!-- Opacity -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Opacity" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding HorizonOpacity, Converter={StaticResource Percent}, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Margin="0,0,0,14"
                                                AutomationProperties.Name="Horizon line opacity"
                                                Value="{Binding HorizonOpacity, Converter={StaticResource Percent}, Mode=TwoWay}" />
                                        <!-- Position -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Position" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding HorizonPosition, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="20" Maximum="80" Margin="0,0,0,14"
                                                AutomationProperties.Name="Horizon line vertical position"
                                                Value="{Binding HorizonPosition, Mode=TwoWay}" />
                                        <!-- Width -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Width" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding HorizonWidth, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="16" Maximum="90" Margin="0,0,0,14"
                                                AutomationProperties.Name="Horizon line width"
                                                Value="{Binding HorizonWidth, Mode=TwoWay}" />
                                        <!-- Style -->
                                        <TextBlock Text="Style" FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Margin="0,0,0,6" />
                                        <Border Style="{StaticResource SegmentedContainer}" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton GroupName="HorizonStyleGroup" Content="Full"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding HorizonStyle, Converter={StaticResource EnumToBool}, ConverterParameter=FullLine}" />
                                                <RadioButton GroupName="HorizonStyleGroup" Content="Split"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding HorizonStyle, Converter={StaticResource EnumToBool}, ConverterParameter=Segmented}" />
                                                <RadioButton GroupName="HorizonStyleGroup" Content="Ticks"
                                                             Style="{StaticResource SegmentedOption}"
                                                             IsChecked="{Binding HorizonStyle, Converter={StaticResource EnumToBool}, ConverterParameter=SideTicks}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Gentle vignette -->
                            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Gentle vignette"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Gentle vignette"
                                                  IsChecked="{Binding VignetteEnabled}" />
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding VignetteEnabled}"
                                                Opacity="{Binding VignetteEnabled, Converter={StaticResource BoolToOpacity}}">
                                        <!-- Opacity -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Opacity" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding VignetteOpacity, Converter={StaticResource Percent}, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Margin="0,0,0,14"
                                                AutomationProperties.Name="Vignette opacity"
                                                Value="{Binding VignetteOpacity, Converter={StaticResource Percent}, Mode=TwoWay}" />
                                        <!-- Radius -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Radius" FontSize="13" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding VignetteRadius, StringFormat={}{0:F0}%}"
                                                       FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                       FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                        </Grid>
                                        <Slider Minimum="20" Maximum="95" Margin="0,0,0,0"
                                                AutomationProperties.Name="Vignette radius"
                                                Value="{Binding VignetteRadius, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Monitor -->
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="Monitor"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <ComboBox x:Name="MonitorCombo"
                                              AutomationProperties.Name="Overlay monitor"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding MonitorId, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    </Grid>
                </ScrollViewer>

                <!-- ─── PRESETS VIEW ─── -->
                <ScrollViewer x:Name="PresetsView">
                    <StackPanel>
                        <TextBlock Text="Friendly presets"
                                   FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Conservative starting points. Tune from these slowly — comfort triggers vary widely between players."
                                   FontSize="13"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20" />
                        <UniformGrid x:Name="PresetGrid" Columns="2" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── HOTKEYS VIEW ─── -->
                <ScrollViewer x:Name="HotkeysView" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Hotkeys"
                                   FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,20" />
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Toggle overlay"
                                                   FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Click the button, then press your shortcut"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkDimBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="ToggleHotkeyBtn"
                                            FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                            FontSize="12"
                                            Padding="10,8"
                                            Click="StartToggleHotkeyCapture" />
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Row="1"
                                        Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,0,0,14" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Emergency off"
                                                   FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Click the button, then press your shortcut"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkDimBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="EmergencyHotkeyBtn"
                                            FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                            FontSize="12"
                                            Padding="10,8"
                                            Click="StartEmergencyHotkeyCapture" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Warning notice (shown when hotkeys conflict) -->
                        <Border Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding HotkeyStatusText}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── SAFETY VIEW ─── -->
                <ScrollViewer x:Name="SafetyView" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Safety"
                                   FontSize="20" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Read before using the overlay."
                                   FontSize="13"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Margin="0,0,0,20" />

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="May help — does not treat"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Dot[9] is an experimental comfort tool. It does not cure, prevent, diagnose, or treat motion sickness, vertigo, migraine, vestibular disorders, or any medical condition."
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Listen to your body"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Stop playing if you feel strong nausea, dizziness, headache, or disorientation. Press your off shortcut (F9 by default) to disable the overlay instantly."
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Avoid intensity"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="High contrast and rapid animation can increase discomfort. Start with the Gentle preset and tune slowly from there."
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Comfort triggers vary"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Rotation, bobbing, acceleration, FOV, camera shake, and peripheral motion all affect different players differently. Presets are starting points, not answers."
                                           FontSize="13"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── ABOUT VIEW ─── -->
                <ScrollViewer x:Name="AboutView" Visibility="Collapsed">
                    <StackPanel>

                        <!-- Card 1: product info -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <controls:WordmarkControl Margin="0,0,0,16" />

                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,0,0,10"
                                           Text="dot[9] is a small comfort tool for motion-heavy games. It adds subtle visual anchors over your screen: stable dots, a centre point, a horizon line, and a gentle vignette." />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,0,0,10"
                                           Text="Game-related motion discomfort is often linked to sensory conflict: your eyes see fast camera movement while your body feels still. dot[9] uses stable, screen-fixed anchors as a quiet reference frame." />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource InkMutedBrush}"
                                           Margin="0,0,0,20"
                                           Text="An independent fan-made comfort prototype. Not a medical device. Settings stay local — no telemetry." />

                                <!-- Metadata grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="VERSION" FontSize="11" Foreground="{StaticResource InkDimBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="LICENSE" FontSize="11" Foreground="{StaticResource InkDimBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" Margin="0,0,0,2" />
                                        <TextBlock Text="All rights reserved" FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="1">
                                        <TextBlock Text="STACK" FontSize="11" Foreground="{StaticResource InkDimBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" Margin="0,0,0,2" />
                                        <TextBlock Text="WPF · .NET 10" FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1">
                                        <TextBlock Text="TELEMETRY" FontSize="11" Foreground="{StaticResource InkDimBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" Margin="0,0,0,2" />
                                        <TextBlock Text="None" FontSize="12" Foreground="{StaticResource InkMutedBrush}"
                                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas" />
                                    </StackPanel>
                                </Grid>

                                <!-- Source link -->
                                <TextBlock Margin="0,18,0,0" FontSize="12.5">
                                    <Hyperlink NavigateUri="https://github.com/JGM-89/dot9"
                                               RequestNavigate="OpenExternalLink"
                                               Foreground="{StaticResource AccentBrush}">
                                        View source on GitHub →
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Card: updates -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Automatic update checks"
                                              IsChecked="{Binding AutoUpdateEnabled}" />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,12"
                                           Text="Automatically check GitHub for new versions on launch. This sends no telemetry — it's only a version check. Downloaded updates apply the next time you open Dot[9]." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check for updates" Click="CheckForUpdates_Click"
                                            Margin="0,0,12,0" />
                                    <Button Content="Restart now" Click="RestartToApplyUpdate_Click"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                            Visibility="{Binding UpdateReadyToApply, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding UpdateStatusText}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- ── Footer ── -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="An independent fan-made comfort prototype. Not a medical device."
                               FontSize="11"
                               Foreground="{StaticResource InkDimBrush}" />
                    <TextBlock Margin="8,0,0,0" FontSize="11">
                        <Hyperlink NavigateUri="about:safety" RequestNavigate="FooterSafetyNavigate"
                                   Foreground="{StaticResource AccentBrush}">
                            Safety →
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
